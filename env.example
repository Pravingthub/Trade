# Copy this file to .env on YOUR computer and fill it in. Never upload .env.
PRAVIN_DATA_PROVIDER=fixture          # fixture (demo) or kite (your downloaded Zerodha history)

# Zerodha Kite Connect (developers.kite.trade). The secret stays on your computer.
KITE_API_KEY=
KITE_API_SECRET=

# Telegram alerts: create a bot with @BotFather, then message it once and get your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional AI summary in the morning brief (pip install openai). Set a model name you have access to.
OPENAI_API_KEY=
OPENAI_MODEL=

# Global markets (free): create a key at fred.stlouisfed.org → My Account → API Keys
FRED_API_KEY=
