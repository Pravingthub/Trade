# Copy to .env (never commit .env). Phase 1 needs NONE of these.
PRAVIN_DATA_PROVIDER=fixture        # fixture | zerodha (Milestone 5)
PRAVIN_AI_ENABLED=false             # core calculations never need AI

# Milestone 3 (Supabase) - server side only
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY lives in the server secret store, never here in git.

# Milestone 5 (Zerodha Kite Connect) - server side only
KITE_API_KEY=
# KITE_API_SECRET lives in the server secret store, never in git or chat.

# Milestone 6
OPENAI_API_KEY=
AI_MONTHLY_BUDGET_INR=500
